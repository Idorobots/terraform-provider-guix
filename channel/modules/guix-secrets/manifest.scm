(define-module (guix-secrets manifest)
  #:use-module (json)
  #:use-module (guix-secrets files)
  #:use-module (ice-9 match)
  #:export (load-manifest))

(define (load-manifest file)
  "Read a data-only JSON manifest. Relative sources are relative to FILE."
  (let* ((file (canonicalize-path file))
         (document (call-with-input-file file json->scm))
         (files (assoc-ref document "files")))
    (unless (and (equal? 1 (assoc-ref document "version")) (vector? files))
      (error "expected secret manifest version 1 and a files array"))
    (validate-payload
     (map (lambda (entry)
            (let ((source (assoc-ref entry "source"))
                  (destination (assoc-ref entry "destination"))
                  (mode (or (assoc-ref entry "mode") "0600")))
              (unless (and (string? source) (string? mode)
                           (= 4 (string-length mode))
                           (char=? #\0 (string-ref mode 0))
                           (string-every (lambda (c) (char<=? #\0 c #\7)) mode)
                           (valid-destination? destination))
                (error "invalid secret source, destination or octal mode"))
              (let ((source (if (string-prefix? "/" source) source
                                (string-append (dirname file) "/" source))))
                (unless (eq? 'regular (stat:type (stat source)))
                  (error "secret source must be a regular file"))
                (list destination (string->number mode 8) (read-bytes source)))))
          (vector->list files)))))
