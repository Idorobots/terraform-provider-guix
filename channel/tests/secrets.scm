(use-modules (guix extensions secrets)
             (guix-secrets files)
             (guix-secrets manifest)
             (guix-secrets image)
             (guix-secrets deploy)
             (guix-secrets helper)
             (guix-secrets privileged)
             (guix-secrets tools)
             (rnrs bytevectors)
             (rnrs io ports)
             (srfi srfi-64)
             (ice-9 ftw)
             (ice-9 popen))

(test-begin "secrets")
(define runner (test-runner-current))
(let* ((name (string-copy "/tmp/guix-secrets-log-XXXXXX"))
       (port (mkstemp! name)))
  (close-port port)
  (dynamic-wind
    (const #t)
    (lambda ()
      (let ((pid (spawn-logged "/bin/sh" name "-c" "printf stdout; printf stderr >&2")))
        (test-equal "filesystem tool exits successfully" 0 (cdr (waitpid pid)))
        (test-equal "filesystem tool diagnostics are captured"
                    "stdoutstderr" (call-with-input-file name get-string-all)))
      (for-each
       (lambda (entry)
         (call-with-output-file name (lambda (port) (display (car entry) port)))
         (test-eqv (car entry) (cadr entry)
                   (if ((@@ (guix-secrets image) capability-error?) name) #t #f)))
       '(("fuse: device not found, try modprobe fuse" #t)
         ("fusermount3: mount failed: Operation not permitted" #t)
         ("fuse: mounting failed: Permission denied" #t)
         ("fuse: failed to mount /tmp/root: Operation not supported" #t)
         ("FUSE2FS (image): bad superblock" #f)
         ("FUSE2FS (image): permission denied opening filesystem" #f))))
    (lambda () (delete-file name))))
(test-assert "absolute destination" (valid-destination? "/etc/sops/age/keys.txt"))
(for-each (lambda (path)
            (test-assert (string-append "reject " path) (not (valid-destination? path))))
          '("/" "relative" "/gnu/store/key" "/gnu/store" "/etc/../key" "/etc//key" "/etc/./key"))
(test-error "overlapping destinations" #t
            (validate-payload `(("/etc/key" 384 #vu8()) ("/etc/key/child" 384 #vu8()))))

(let* ((root (mkdtemp "/tmp/guix-secrets-test-XXXXXX"))
       (file (string-append root "/etc/private/key"))
       (bytes #vu8(0 1 2 255 10)))
  (dynamic-wind
    (const #t)
    (lambda ()
      (install-payload root `(("/etc/private/key" #o600 ,bytes))
                       #:owner (getuid) #:group (getgid))
      (test-equal "binary contents" bytes (read-bytes file))
      (test-equal "mode" #o600 (logand #o777 (stat:perms (stat file))))
      (test-equal "private new parent" #o700 (stat:perms (stat (dirname file))))
      (install-payload root '(("/etc/private/key" #o640 #vu8()))
                       #:owner (getuid) #:group (getgid))
      (test-equal "replace with empty content" #vu8() (read-bytes file))
      (test-equal "updated mode" #o640 (stat:perms (stat file)))
      (symlink "/tmp" (string-append root "/escape"))
      (test-error "symlink parent rejected" #t
                  (install-payload root '(("/escape/leak" #o600 #vu8(1)))))
      (symlink file (string-append root "/link"))
      (test-error "symlink leaf rejected" #t
                  (install-payload root '(("/link" #o600 #vu8(1))))))
    (lambda ()
      (delete-file (string-append root "/escape"))
      (delete-file (string-append root "/link"))
      (delete-file file)
      (rmdir (dirname file)) (rmdir (string-append root "/etc")) (rmdir root))))

(when (getenv "GUIX_SECRETS_BUILD_HELPER")
  (let ((helper (image-helper)))
    (test-assert "Polkit helper is an immutable executable"
                 (and (string-prefix? "/gnu/store/" helper) (access? helper X_OK)))
    (let ((pipe (open-pipe* OPEN_BOTH "sh" "-c" "exec \"$1\" 2>&1" "sh" helper)))
      (write '("/tmp/not-an-image" 0 1 ()) pipe) (newline pipe)
      (force-output pipe)
      (let ((output (get-string-all pipe)))
        (test-assert "helper loaded its immutable modules"
                     (and (string-contains output "privileged provisioning failed")
                          (not (string-contains output "Backtrace"))))
        (test-assert "helper rejects invalid/unprivileged requests" (not (zero? (close-pipe pipe))))))))

(test-end "secrets")
(exit (if (zero? (test-runner-fail-count runner)) 0 1))
